/**
 * Pointer/keyboard gestures for the Edit Draft 3D canvas. Every gesture maps
 * to an existing reversible command via the edit controller callbacks:
 *   MOVE drag → MOVE_NODE (drop on another node → MERGE_NODES)
 *   CONNECT drag node→node → BRIDGE_GAP · ADD drag from node → ADD_STRAIGHT_ELEMENT
 *   SPLIT click on edge → SPLIT_EDGE (fraction from the picked point)
 *   click/ctrl/shift select · shift-drag box select · Del / Ctrl+Z / Ctrl+Y / arrows
 * Axis lock: press X / Y / Z during a drag.
 */

import { asArray, cleanText, objectRecord } from './topology-validator-values.js';
import { selectionForObjectId } from './topology-edit-controller-helpers.js';

const AXES = Object.freeze({ x: [1, 0, 0], y: [0, 1, 0], z: [0, 0, 1] });

const vSub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
const vAdd = (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
const vScale = (a, s) => [a[0] * s, a[1] * s, a[2] * s];
const vDot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
const vLen = (a) => Math.hypot(a[0], a[1], a[2]);

/** Intersect a ray with the plane through `point` with normal `normal`. */
function rayPlane(ray, point, normal) {
  const denom = vDot(ray.direction, normal);
  if (Math.abs(denom) < 1e-9) return null;
  const t = vDot(vSub(point, ray.origin), normal) / denom;
  return t > 0 ? vAdd(ray.origin, vScale(ray.direction, t)) : null;
}

/** Closest parameter s of line (origin + s·dir) to a ray. */
function lineParamClosestToRay(lineOrigin, lineDir, ray) {
  const w = vSub(lineOrigin, ray.origin);
  const a = vDot(lineDir, lineDir), b = vDot(lineDir, ray.direction), c = vDot(ray.direction, ray.direction);
  const d = vDot(lineDir, w), e = vDot(ray.direction, w);
  const denom = a * c - b * b;
  if (Math.abs(denom) < 1e-9) return 0;
  return (b * e - c * d) / denom;
}

function nodePosition(canonical, nodeId) {
  const node = asArray(canonical.nodes).map(objectRecord).find((row) => cleanText(row.id) === nodeId);
  return node ? [node.position.x, node.position.y, node.position.z] : null;
}

function adjacentEdgeId(canonical, nodeId) {
  const edge = asArray(canonical.edges).map(objectRecord)
    .find((row) => cleanText(row.fromNodeId) === nodeId || cleanText(row.toNodeId) === nodeId);
  return edge ? cleanText(edge.id) : '';
}

function neighborPositions(canonical, nodeId) {
  return asArray(canonical.edges).map(objectRecord).flatMap((edge) => {
    const from = cleanText(edge.fromNodeId), to = cleanText(edge.toNodeId);
    if (from !== nodeId && to !== nodeId) return [];
    const other = nodePosition(canonical, from === nodeId ? to : from);
    return other ? [other] : [];
  });
}

const round1 = (value) => Math.round(value * 10) / 10;
const positionRecord = (point) => ({ x: round1(point[0]), y: round1(point[1]), z: round1(point[2]) });

export function wireTopologyEditGestures({ host, viewer, callbacks, input }) {
  let drag = null; // { type, nodeId, start, current, edgeId }
  let axisLock = null; // 'x' | 'y' | 'z' | null
  let boxEl = null;
  let downPos = null; // distinguish clicks from orbit drags
  const canonical = () => input()?.draft ?? { nodes: [], edges: [] };
  const cb = () => callbacks() ?? {};

  function dragPoint(event) {
    const ray = viewer().screenRay(event.clientX, event.clientY);
    if (axisLock) {
      const s = lineParamClosestToRay(drag.start, AXES[axisLock], ray);
      return vAdd(drag.start, vScale(AXES[axisLock], s));
    }
    // Camera-facing plane through the drag origin keeps motion intuitive.
    return rayPlane(ray, drag.start, vScale(ray.direction, -1)) ?? drag.start;
  }

  function showDragOverlay() {
    const overlay = { spheres: [{ position: drag.current, radiusMm: 30 }], lines: [] };
    if (drag.type === 'move') {
      for (const neighbor of drag.neighbors) overlay.lines.push({ points: [neighbor, drag.current] });
    } else {
      overlay.lines.push({ points: [drag.start, drag.current], colorInt: drag.type === 'connect' ? 0x22d3ee : 0xf59e0b });
    }
    viewer().setTransient(overlay);
  }

  function onPointerDown(event) {
    downPos = [event.clientX, event.clientY];
    if (event.button !== 0) return;
    const tool = String(cb().getTool?.() ?? 'SELECT');
    if (event.shiftKey && tool === 'SELECT') { startBox(event); return; }
    if (!['MOVE', 'CONNECT', 'ADD'].includes(tool)) return;
    const pick = viewer().pickAt(event.clientX, event.clientY);
    if (!pick || pick.modelId !== 'target' || !pick.nodeId) return;
    const start = nodePosition(canonical(), cleanText(pick.nodeId));
    if (!start) return;
    event.stopPropagation();
    event.preventDefault();
    drag = {
      type: tool.toLowerCase(), nodeId: cleanText(pick.nodeId), start, current: start,
      neighbors: tool === 'MOVE' ? neighborPositions(canonical(), cleanText(pick.nodeId)) : [],
    };
    host.setPointerCapture?.(event.pointerId);
  }

  function onPointerMove(event) {
    if (drag) { drag.current = dragPoint(event); showDragOverlay(); return; }
    if (boxEl) updateBox(event);
  }

  async function onPointerUp(event) {
    if (boxEl) { await finishBox(event); return; }
    if (!drag) return;
    const finished = drag;
    drag = null;
    viewer().setTransient(null);
    const moved = vLen(vSub(finished.current, finished.start));
    try {
      if (finished.type === 'move') {
        const pick = viewer().pickAt(event.clientX, event.clientY);
        const targetNode = pick?.modelId === 'target' ? cleanText(pick.nodeId) : '';
        if (targetNode && targetNode !== finished.nodeId) {
          await cb().executeCommand('MERGE_NODES', { sourceNodeId: finished.nodeId, targetNodeId: targetNode });
        } else if (moved > 0.5) {
          await cb().executeCommand('MOVE_NODE', { nodeId: finished.nodeId, position: positionRecord(finished.current) });
        }
      } else if (finished.type === 'connect') {
        const pick = viewer().pickAt(event.clientX, event.clientY);
        const targetNode = pick?.modelId === 'target' ? cleanText(pick.nodeId) : '';
        if (!targetNode || targetNode === finished.nodeId) throw new Error('Connect: drop on a second node to bridge the gap.');
        const contextEdgeId = cb().getContextEdgeId?.() || adjacentEdgeId(canonical(), finished.nodeId);
        if (!contextEdgeId) throw new Error('Connect requires an engineering context edge (select one first).');
        await cb().executeCommand('BRIDGE_GAP', { fromNodeId: finished.nodeId, toNodeId: targetNode, contextEdgeId });
      } else if (finished.type === 'add' && moved > 0.5) {
        const contextEdgeId = cb().getContextEdgeId?.() || adjacentEdgeId(canonical(), finished.nodeId);
        if (!contextEdgeId) throw new Error('Add requires an engineering context edge (select one first).');
        await cb().executeCommand('ADD_STRAIGHT_ELEMENT', { fromNodeId: finished.nodeId, toPosition: positionRecord(finished.current), contextEdgeId });
      }
    } catch (error) { cb().onGestureError?.(error); }
  }

  async function onClick(event) {
    if (event.detail > 1) return; // double-click recenters via the viewer
    if (downPos && Math.hypot(event.clientX - downPos[0], event.clientY - downPos[1]) > 5) return; // orbit drag
    const pick = viewer().pickAt(event.clientX, event.clientY);
    const tool = String(cb().getTool?.() ?? 'SELECT');
    if (!pick || pick.modelId === 'source') { if (!event.ctrlKey && !event.metaKey) cb().setSelection?.([], true); return; }
    if (pick.connector) return;
    const row = pick.nodeId ? { kind: 'node', id: cleanText(pick.nodeId) } : selectionForObjectId(canonical(), cleanText(pick.objectId));
    if (!row) { cb().onGhostPick?.(cleanText(pick.objectId)); return; }
    if (tool === 'SPLIT' && row.kind === 'edge') {
      try {
        const edge = asArray(canonical().edges).map(objectRecord).find((item) => cleanText(item.id) === row.id);
        const from = nodePosition(canonical(), cleanText(edge?.fromNodeId)), to = nodePosition(canonical(), cleanText(edge?.toNodeId));
        if (!from || !to) throw new Error('Split: edge endpoints not found.');
        const ray = viewer().screenRay(event.clientX, event.clientY);
        const s = lineParamClosestToRay(from, vSub(to, from), ray);
        const fraction = Math.min(0.95, Math.max(0.05, Math.round(s * 100) / 100));
        await cb().executeCommand('SPLIT_EDGE', { edgeId: row.id, fraction });
      } catch (error) { cb().onGestureError?.(error); }
      return;
    }
    cb().selectFromPointer?.(row, event);
  }

  function startBox(event) {
    boxEl = host.ownerDocument.createElement('div');
    boxEl.style.cssText = 'position:absolute;border:1px dashed #38bdf8;background:rgba(56,189,248,.12);pointer-events:none;z-index:20;';
    boxEl.dataset.x0 = String(event.clientX); boxEl.dataset.y0 = String(event.clientY);
    host.appendChild(boxEl);
    updateBox(event);
    event.stopPropagation();
    event.preventDefault();
  }

  function updateBox(event) {
    const rect = host.getBoundingClientRect();
    const x0 = Number(boxEl.dataset.x0), y0 = Number(boxEl.dataset.y0);
    boxEl.style.left = `${Math.min(x0, event.clientX) - rect.left}px`;
    boxEl.style.top = `${Math.min(y0, event.clientY) - rect.top}px`;
    boxEl.style.width = `${Math.abs(event.clientX - x0)}px`;
    boxEl.style.height = `${Math.abs(event.clientY - y0)}px`;
    boxEl.dataset.x1 = String(event.clientX); boxEl.dataset.y1 = String(event.clientY);
  }

  async function finishBox(event) {
    const rect = host.getBoundingClientRect();
    const x0 = Number(boxEl.dataset.x0), y0 = Number(boxEl.dataset.y0);
    const [minX, maxX] = [Math.min(x0, event.clientX), Math.max(x0, event.clientX)].map((v) => v - rect.left);
    const [minY, maxY] = [Math.min(y0, event.clientY), Math.max(y0, event.clientY)].map((v) => v - rect.top);
    boxEl.remove(); boxEl = null;
    if (maxX - minX < 4 && maxY - minY < 4) return;
    const rows = asArray(canonical().nodes).map(objectRecord).flatMap((node) => {
      const screen = viewer().projectPoint([node.position.x, node.position.y, node.position.z]);
      if (!screen || screen.x < minX || screen.x > maxX || screen.y < minY || screen.y > maxY) return [];
      return [{ kind: 'node', id: cleanText(node.id) }];
    });
    cb().setSelection?.(rows, true);
  }

  async function onKeyDown(event) {
    if (!host.matches(':hover') && !host.contains(host.ownerDocument.activeElement)) return;
    const key = event.key.toLowerCase();
    if (drag && ['x', 'y', 'z'].includes(key)) {
      axisLock = axisLock === key ? null : key;
      cb().onHint?.(axisLock ? `Axis lock: ${axisLock.toUpperCase()}` : 'Axis lock off');
      return;
    }
    try {
      if ((event.ctrlKey || event.metaKey) && key === 'z') { event.preventDefault(); await (event.shiftKey ? cb().redo?.() : cb().undo?.()); return; }
      if ((event.ctrlKey || event.metaKey) && key === 'y') { event.preventDefault(); await cb().redo?.(); return; }
      if (key === 'delete' || key === 'backspace') { event.preventDefault(); await cb().runOperation?.('DELETE'); return; }
      if (['arrowleft', 'arrowright', 'arrowup', 'arrowdown'].includes(key)) {
        const nodes = (cb().getSelection?.() ?? []).filter((row) => row.kind === 'node');
        if (nodes.length !== 1) return;
        event.preventDefault();
        const step = event.shiftKey ? 10 : 1;
        const vertical = String(input()?.verticalAxis ?? 'Y').toUpperCase() === 'Z' ? 'z' : 'y';
        const delta = key === 'arrowleft' ? { axis: 'x', sign: -1 } : key === 'arrowright' ? { axis: 'x', sign: 1 }
          : key === 'arrowup' ? { axis: vertical, sign: 1 } : { axis: vertical, sign: -1 };
        const start = nodePosition(canonical(), nodes[0].id);
        if (!start) return;
        const moved = vAdd(start, vScale(AXES[delta.axis], delta.sign * step));
        await cb().executeCommand('MOVE_NODE', { nodeId: nodes[0].id, position: positionRecord(moved) });
      }
    } catch (error) { cb().onGestureError?.(error); }
  }

  const windowRef = host.ownerDocument.defaultView;
  host.addEventListener('pointerdown', onPointerDown, true);
  windowRef.addEventListener('pointermove', onPointerMove);
  windowRef.addEventListener('pointerup', onPointerUp);
  host.addEventListener('click', onClick);
  windowRef.addEventListener('keydown', onKeyDown);
  return () => {
    host.removeEventListener('pointerdown', onPointerDown, true);
    windowRef.removeEventListener('pointermove', onPointerMove);
    windowRef.removeEventListener('pointerup', onPointerUp);
    host.removeEventListener('click', onClick);
    windowRef.removeEventListener('keydown', onKeyDown);
    boxEl?.remove();
  };
}

export const _test = Object.freeze({ rayPlane, lineParamClosestToRay, positionRecord });
